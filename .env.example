# ProcureSphere 360 Environment Configuration
DJANGO_SECRET_KEY=change-me-in-production-use-a-strong-random-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database. When DATABASE_URL is set, Django ignores DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, and DB_PORT.
# Direct Supabase hosts are often IPv6-only. Use the IPv4 session pooler and sslmode=require.
# User must be postgres.<project-ref>, not the local Docker user procure_user.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Local PostgreSQL only. Leave these commented while DATABASE_URL is set.
# DB_NAME=procuresphere_db
# DB_USER=procure_user
# DB_PASSWORD=procure_password
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# JWT Auth Configuration
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# File Upload Configuration
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_FILE_EXTENSIONS=pdf,png,jpg,jpeg,doc,docx,xlsx,csv

# CORS & Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
